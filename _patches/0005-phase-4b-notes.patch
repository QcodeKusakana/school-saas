+                                <?php else: ?>
+                                    <span class="small text-warning-emphasis">
+                                        <i class="bi bi-exclamation-circle me-1"></i>non pourvue
+                                    </span>
+                                <?php endif; ?>
+                            </td>
+
+                            <?php foreach ($periods as $periodId => $period): ?>
