# =====================================================================
#  Protection de la racine du projet.
#
#  Cas normal : la racine web pointe sur /public et ce fichier n'est
#  jamais lu.
#
#  Cas où la racine web ne peut pas être déplacée (mutualisé, ou hôte
#  virtuel généré avant l'existence du dossier public) : ce fichier
#  redirige le trafic vers public/ et interdit l'accès aux dossiers
#  internes.
# =====================================================================

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Aucun accès direct aux dossiers internes.
    RewriteRule ^(app|storage|database|docs|tests)/ - [F,L]

    # Redirection vers public/.
    #
    # Le (?!public/) est indispensable : après une réécriture interne,
    # %{REQUEST_URI} conserve l'URI D'ORIGINE et ne reflète pas le
    # nouveau chemin. Une condition portant sur REQUEST_URI resterait
    # donc vraie à chaque passe et produirait public/public/public/…
    # jusqu'à épuisement de LimitInternalRecursion.
    # Le motif, lui, s'applique bien au chemin réécrit : la boucle
    # s'arrête d'elle-même.
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "\.(sql|log|md|json|lock|ini|yml|yaml)$">
    Require all denied
</FilesMatch>
