# =====================================================================
#  Protection de la racine du projet.
#
#  Cas normal : la racine web pointe sur /public et ce fichier n'est
#  jamais lu.
#
#  Cas cPanel mutualisé où la racine web ne peut pas être déplacée :
#  ce fichier redirige tout le trafic vers public/ tout en interdisant
#  l'accès direct à app/, storage/ et database/.
# =====================================================================

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloque tout accès direct aux dossiers internes.
    RewriteRule ^(app|storage|database|docs)/ - [F,L]

    # Redirige le reste vers public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Ceinture et bretelles : même si mod_rewrite est absent, ces fichiers
# ne doivent jamais être servis.
<FilesMatch "\.(sql|log|md|json|lock|ini|yml|yaml)$">
    Require all denied
</FilesMatch>
