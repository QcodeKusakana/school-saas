# =====================================================================
#  Racine web de l'application.
#  Toutes les requêtes qui ne correspondent pas à un fichier réel
#  sont dirigées vers index.php.
# =====================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Front controller.
    # Un fichier ou un dossier existant (CSS, JS, images, polices) est
    # servi directement par Apache : les deux conditions ci-dessous le
    # garantissent et doivent rester en tête.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Pas de listage de répertoire
Options -Indexes

# Fichiers sensibles jamais servis
<FilesMatch "^(\.env|\.htaccess|\.git.*|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|log|md|ini|yml|yaml|bak|tmp)$">
    Require all denied
</FilesMatch>

# Mise en cache des ressources statiques
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                 "access plus 1 year"
    ExpiresByType application/javascript   "access plus 1 year"
    ExpiresByType image/png                "access plus 1 year"
    ExpiresByType image/jpeg               "access plus 1 year"
    ExpiresByType image/svg+xml            "access plus 1 year"
    ExpiresByType image/webp               "access plus 1 year"
    ExpiresByType font/woff2               "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
</IfModule>

# En-têtes de sécurité de secours pour les fichiers statiques
# (l'application les envoie déjà elle-même pour les pages PHP).
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always unset X-Powered-By
</IfModule>
